@startuml
title Confirm an order: route, transaction and outcomes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
actor Staff as staff
participant "PATCH status route" as route
participant "Order handlers" as handler
database "Prisma / SQLite" as db
staff -> route : PATCH(req, {params})
route -> handler : updateStatus(req, id)
handler -> handler : requireSession(req)\nconfirmOrder(id, actorId)
handler -> db : $transaction(callback, Serializable)
activate db
db -> db : order.updateMany(CREATED → CONFIRMED)
db -> db : [claim succeeded] product.updateMany(stock >= quantity)
alt eligible order and sufficient stock
  db -> db : inventoryLog.create(-quantity)\nnotifyOrderEvent(ORDER_CONFIRMED)
  db --> handler : commit(order)
  deactivate db
  handler --> route : Response.json({order})
  route --> staff : HTTP 200
else invalid state or insufficient stock
  activate db
  db --> handler : rollback(HttpError 409)
  deactivate db
  handler --> route : failure(error)
  route --> staff : HTTP 409
end
@enduml
