{
  "name": "group42-logistics",
  "version": "0.4.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx --test tests/*.integration.ts",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed.ts",
    "dev:local": "next dev --hostname 127.0.0.1",
    "test:browser": "node scripts/browser-smoke.mjs",
    "db:reset-passwords": "tsx scripts/reset-demo-passwords.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "evidence": "node scripts/run-verification.mjs",
    "baseline": "node scripts/write-baseline.mjs",
    "test:integrity": "node --test tests/integrity.check.mjs",
    "db:driver-demo": "tsx scripts/create-demo-driver.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24"
  }
}
