@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
rectangle "Customer" as C <<actor>>
rectangle "Staff" as S <<actor>>
rectangle "Driver" as D <<actor>>
rectangle "Admin" as A <<actor>>
rectangle "Warehouse logistics application" {
  usecase "Sign in" as LOGIN
  usecase "Create order" as CREATE
  usecase "Track order" as TRACK
  usecase "Read notifications" as NOTIFY
  usecase "Cancel order" as CANCEL
  usecase "Confirm order" as CONFIRM
  usecase "Pick order" as PICK
  usecase "Ship order" as SHIP
  usecase "Assign driver" as ASSIGN
  usecase "Manage inventory" as STOCK
  usecase "View assigned deliveries" as TASKS
  usecase "Update delivery" as DELIVERY
  usecase "View reports" as REPORTS
}
C -- LOGIN
S -- LOGIN
LOGIN -- D
LOGIN -- A
C -- CREATE
C -- TRACK
C -- NOTIFY
C -- CANCEL
S -- CANCEL
S -- CONFIRM
S -- PICK
S -- SHIP
S -- ASSIGN
S -- STOCK
S -- DELIVERY
TASKS -- D
DELIVERY -- D
REPORTS -- A
@enduml
