generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PICKING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  orders        Order[]
  notifications Notification[]
  sessions      Session[]
  inventoryLogs InventoryLog[]
}

// 真实登录会话：数据库只保存 token 的 SHA-256，原始 token 仅在浏览器 HttpOnly Cookie 中。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfToken String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Product {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  priceCents        Int
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    User        @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(CREATED)
  totalCents  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  shipment    Shipment?
  notifications Notification[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  trackingNumber String         @unique
  carrier        String
  status         String
  shippedAt      DateTime?
  deliveredAt    DateTime?
  events         TrackingEvent[]
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  at          DateTime @default(now())
  location    String
  description String

  @@index([shipmentId, at])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  type      String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // 同一订单同一事件只允许一条通知：重复/并发请求不会多发。
  @@unique([orderId, type])
  @@index([userId, read])
  @@index([userId, createdAt])
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  delta     Int
  reason    String
  orderId   String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}
