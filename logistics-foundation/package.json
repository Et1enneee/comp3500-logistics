{
  "name": "group42-logistics-foundation",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx --test tests/orders.integration.ts tests/foundation.integration.ts tests/logistics-chain.integration.ts",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed.ts",
    "dev:local": "next dev --hostname 127.0.0.1",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
