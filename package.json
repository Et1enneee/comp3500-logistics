{
  "name": "group42-logistics-repository",
  "version": "0.4.2",
  "private": true,
  "description": "Command entry only; application and dependency lock are in logistics/",
  "scripts": {
    "setup": "npm --prefix logistics ci",
    "dev:local": "npm --prefix logistics run dev:local",
    "build": "npm --prefix logistics run build",
    "start": "npm --prefix logistics run start",
    "typecheck": "npm --prefix logistics run typecheck",
    "test:integration": "npm --prefix logistics run test:integration",
    "lint": "npm --prefix logistics run lint",
    "db:setup": "npm --prefix logistics run db:setup",
    "db:seed:demo": "npm --prefix logistics run db:seed:demo",
    "test:browser": "npm --prefix logistics run test:browser",
    "test": "npm --prefix logistics test",
    "audit": "npm --prefix logistics audit",
    "test:unit": "npm --prefix logistics test",
    "evidence": "npm --prefix logistics run evidence",
    "baseline": "npm --prefix logistics run baseline",
    "verify:migration": "npm --prefix logistics run verify:migration",
    "db:reset-passwords": "npm --prefix logistics run db:reset-passwords",
    "test:delivery": "npm --prefix logistics run test:delivery",
    "db:driver-demo": "npm --prefix logistics run db:driver-demo"
  },
  "engines": {
    "node": ">=24"
  }
}
